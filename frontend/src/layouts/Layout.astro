---
// Layout base: cabecera con navegación, estilos globales y pie de página.
const { titulo = "Amigo Secreto" } = Astro.props;
const ruta = Astro.url.pathname;
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{titulo} · Amigo Secreto</title>
    <meta name="description" content="Intercambio de regalos entre amigos 🎁" />
  </head>
  <body>
    <header class="cabecera">
      <a class="logo" href="/">Amigo <span>Secreto</span> 🎁</a>
      <nav>
        <a href="/" class:list={{ activo: ruta === "/" }}>Inicio</a>
        <a href="/participantes" class:list={{ activo: ruta === "/participantes/" }}>Participantes</a>
        <a href="/mi-lista" class:list={{ activo: ruta.startsWith("/mi-lista") }}>Mi lista</a>
        <a href="/mi-amigo" class:list={{ activo: ruta.startsWith("/mi-amigo") }}>Mi amigo</a>
        <a href="/admin" class:list={{ activo: ruta.startsWith("/admin") }}>Admin</a>
      </nav>
    </header>

    <main>
      <slot />
    </main>

    <footer>
      <p>Hecho con ❤ para el grupo · ¡Feliz Navidad! 🎄</p>
    </footer>

    <style is:global>
      :root {
        --verde: #0e6b3a;
        --verde-oscuro: #0a4d2a;
        --rojo: #c0392b;
        --dorado: #d9a441;
        --crema: #fdf6ec;
        --texto: #2d2a26;
        --gris: #6f6a63;
        --borde: #e7ddcd;
        --blanco: #ffffff;
      }
      * {
        box-sizing: border-box;
      }
      body {
        margin: 0;
        min-height: 100vh;
        display: flex;
        flex-direction: column;
        background: var(--crema);
        color: var(--texto);
        font-family: system-ui, -apple-system, "Segoe UI", Roboto, sans-serif;
        line-height: 1.55;
      }
      main {
        flex: 1;
        width: min(860px, 100% - 2rem);
        margin-inline: auto;
        padding-block: 2rem 3rem;
      }
      .cabecera {
        background: var(--verde);
        color: var(--blanco);
        padding: 0.9rem 1.5rem;
        display: flex;
        flex-wrap: wrap;
        gap: 0.75rem 1.5rem;
        align-items: center;
        justify-content: space-between;
        box-shadow: 0 2px 10px rgb(0 0 0 / 0.15);
      }
      .logo {
        font-size: 1.25rem;
        font-weight: 800;
        color: var(--blanco);
        text-decoration: none;
        letter-spacing: 0.3px;
      }
      .logo span {
        color: var(--dorado);
      }
      .cabecera nav {
        display: flex;
        gap: 1rem;
        flex-wrap: wrap;
      }
      .cabecera nav a {
        color: #eaf7ef;
        text-decoration: none;
        font-weight: 600;
        padding: 0.2rem 0.5rem;
        border-radius: 8px;
      }
      .cabecera nav a:hover {
        background: var(--verde-oscuro);
      }
      .cabecera nav a.activo {
        background: var(--verde-oscuro);
        color: var(--dorado);
      }
      footer {
        text-align: center;
        color: var(--gris);
        padding: 1.2rem;
        font-size: 0.9rem;
      }

      h1 {
        font-size: 1.9rem;
        margin: 0 0 0.5rem;
        color: var(--verde-oscuro);
      }
      h2 {
        font-size: 1.25rem;
        margin: 1.5rem 0 0.75rem;
        color: var(--verde-oscuro);
      }

      .tarjeta {
        background: var(--blanco);
        border: 1px solid var(--borde);
        border-radius: 14px;
        padding: 1.25rem 1.4rem;
        box-shadow: 0 2px 8px rgb(0 0 0 / 0.05);
      }

      .btn {
        display: inline-block;
        background: var(--rojo);
        color: var(--blanco);
        border: none;
        border-radius: 10px;
        padding: 0.6rem 1.2rem;
        font-size: 1rem;
        font-weight: 700;
        cursor: pointer;
        text-decoration: none;
        transition: transform 0.06s ease, filter 0.15s ease;
      }
      .btn:hover {
        filter: brightness(1.08);
      }
      .btn:active {
        transform: scale(0.98);
      }
      .btn.secundario {
        background: var(--verde);
      }
      .btn.fantasma {
        background: transparent;
        color: var(--gris);
        border: 1px solid var(--borde);
        font-weight: 600;
      }
      .btn:disabled {
        opacity: 0.5;
        cursor: not-allowed;
      }

      label {
        display: block;
        font-weight: 600;
        font-size: 0.9rem;
        margin: 0.75rem 0 0.25rem;
      }
      input,
      textarea {
        width: 100%;
        padding: 0.55rem 0.7rem;
        border: 1px solid var(--borde);
        border-radius: 9px;
        font: inherit;
        background: #fffdf9;
      }
      input:focus,
      textarea:focus {
        outline: 2px solid var(--dorado);
        border-color: transparent;
      }

      .aviso {
        border-radius: 10px;
        padding: 0.7rem 1rem;
        margin: 0.75rem 0;
        font-weight: 600;
        display: none;
      }
      .aviso.error {
        display: block;
        background: #fdecea;
        color: var(--rojo);
        border: 1px solid #f5c6c0;
      }
      .aviso.ok {
        display: block;
        background: #e8f5ee;
        color: var(--verde-oscuro);
        border: 1px solid #bfe3cf;
      }

      .paso {
        font-size: 0.85rem;
        font-weight: 800;
        color: var(--dorado);
        text-transform: uppercase;
        letter-spacing: 1px;
      }
      .oculto {
        display: none;
      }
    </style>
  </body>
</html>
