---
// Layout base con la estética navideña elegante: fondo beige, barra lateral
// verde con la navegación y tipografías serif (títulos) + sans espaciada.
// En móvil la barra pasa arriba como cinta horizontal.
const { titulo = "Amigo Secreto" } = Astro.props;
const ruta = Astro.url.pathname;

const enlaces = [
  { href: "/", texto: "Inicio", activo: (p: string) => p === "/" },
  { href: "/participantes", texto: "Participantes", activo: (p: string) => p.startsWith("/participantes") },
  { href: "/mi-lista", texto: "Mi lista", activo: (p: string) => p.startsWith("/mi-lista") },
  { href: "/mi-amigo", texto: "Mi amigo", activo: (p: string) => p.startsWith("/mi-amigo") },
  { href: "/ingresar", texto: "Iniciar sesión", activo: (p: string) => p.startsWith("/ingresar") },
];
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{titulo} · Amigo Secreto</title>
    <meta name="description" content="Intercambio de regalos entre amigos 🎁" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Playfair+Display:wght@600;700;800&family=Jost:wght@300;400;500;600&display=swap"
      rel="stylesheet"
    />
  </head>
  <body>
    <!-- Barra lateral (desktop) / cinta superior con menú hamburguesa (móvil) -->
    <aside class="sidebar" id="sidebar">
      <a class="logo" href="/">AMIGO<span>SECRETO</span></a>

      <button
        class="btn-hamburguesa"
        id="btn-menu"
        type="button"
        aria-label="Abrir menú"
        aria-expanded="false"
        aria-controls="menu-nav"
      >
        <span></span><span></span><span></span>
      </button>

      <nav id="menu-nav">
        {
          enlaces.map((e) => (
            <a href={e.href} class:list={{ activo: e.activo(ruta) }}>
              {e.texto}
            </a>
          ))
        }
      </nav>

      <img src="/img/bola.png" alt="" class="bola-sidebar" />
    </aside>
    <main>
      <slot />
    </main>

    <footer>
      <img src="/img/ramita.png" alt="" class="ramita" />
      <p>Hecho con ❤ para Carta Mayor · ¡Feliz Navidad! 🎄</p>
    </footer>

    <style is:global>
      :root {
        --fondo: #c6bfa3;
        --verde: #4d6e4b;
        --verde-oscuro: #3d5a3c;
        --rojo: #b94359;
        --rojo-oscuro: #a2384d;
        --titulo: #535353;
        --texto: #4a463f;
        --gris: #7d776c;
        --marfil: #f5f1e6;
        --borde: #d9d2c2;
        --dorado: #c9a86a;
      }
      * {
        box-sizing: border-box;
      }
      body {
        margin: 0;
        min-height: 100vh;
        background: var(--fondo);
        color: var(--texto);
        font-family: "Jost", system-ui, sans-serif;
        font-weight: 400;
        line-height: 1.6;
        overflow-x: clip; /* los adornos absolutos no deben generar scroll */
      }

      /* ---------- Barra lateral ---------- */
      .sidebar {
        position: fixed;
        inset: 1.4rem auto 1.4rem 1.4rem;
        width: 215px;
        background: var(--verde);
        border-radius: 26px;
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: space-between;
        padding: 2.2rem 1rem 1.8rem;
        z-index: 10;
        box-shadow: 0 10px 30px rgb(0 0 0 / 0.12);
      }
      .logo {
        font-family: "Playfair Display", serif;
        font-weight: 700;
        font-size: 1.05rem;
        letter-spacing: 0.18em;
        color: var(--marfil);
        text-decoration: none;
        text-align: center;
        line-height: 1.5;
      }
      .logo span {
        display: block;
        color: var(--dorado);
        font-size: 0.95rem;
      }
      .sidebar nav {
        display: flex;
        flex-direction: column;
        gap: 1.9rem;
        text-align: center;
      }
      .sidebar nav a {
        color: #eef0e6;
        text-decoration: none;
        text-transform: uppercase;
        letter-spacing: 0.22em;
        font-size: 0.8rem;
        font-weight: 400;
        transition: color 0.15s;
      }
      .sidebar nav a:hover {
        color: var(--dorado);
      }
      .sidebar nav a.activo {
        color: #fff;
        font-weight: 600;
      }
      .sidebar .bola-sidebar {
        width: 74px;
        margin-bottom: -3.4rem; /* sobresale por debajo de la barra, como en el diseño */
        filter: drop-shadow(0 10px 14px rgb(0 0 0 / 0.2));
      }

      /* Botón hamburguesa: solo móvil */
      .btn-hamburguesa {
        display: none;
        flex-direction: column;
        justify-content: center;
        gap: 5px;
        width: 42px;
        height: 42px;
        padding: 9px;
        background: transparent;
        border: none;
        border-radius: 10px;
        cursor: pointer;
        flex-shrink: 0;
      }
      .btn-hamburguesa span {
        display: block;
        height: 2.5px;
        width: 100%;
        background: #eef0e6;
        border-radius: 2px;
        transition: transform 0.2s ease, opacity 0.2s ease;
      }
      .btn-hamburguesa:hover {
        background: var(--verde-oscuro);
      }
      .abierto .btn-hamburguesa span:nth-child(1) {
        transform: translateY(7.5px) rotate(45deg);
      }
      .abierto .btn-hamburguesa span:nth-child(2) {
        opacity: 0;
      }
      .abierto .btn-hamburguesa span:nth-child(3) {
        transform: translateY(-7.5px) rotate(-45deg);
      }

      /* ---------- Contenido ---------- */
      main {
        margin-left: 310px;
        padding: 2.5rem 2.5rem 3rem;
        width: calc(100% - 310px);
      }
      footer {
        margin-left: 310px;
        text-align: center;
        color: var(--gris);
        padding: 1rem 2rem 1.6rem;
        font-size: 0.85rem;
        position: relative;
      }
      footer .ramita {
        position: absolute;
        left: 1rem;
        bottom: 0.6rem;
        width: 46px;
        opacity: 0.55;
      }

      h1 {
        font-family: "Playfair Display", serif;
        font-weight: 700;
        font-size: clamp(2rem, 4.5vw, 3.2rem);
        line-height: 1.12;
        letter-spacing: 0.06em;
        text-transform: uppercase;
        color: var(--titulo);
        margin: 0 0 0.6rem;
      }
      h2 {
        font-family: "Playfair Display", serif;
        font-size: 1.35rem;
        letter-spacing: 0.04em;
        color: var(--titulo);
        margin: 1.6rem 0 0.75rem;
      }

      .paso {
        font-size: 0.8rem;
        font-weight: 500;
        color: var(--rojo);
        text-transform: uppercase;
        letter-spacing: 0.28em;
      }

      .tarjeta {
        background: var(--marfil);
        border-radius: 22px;
        padding: 1.4rem 1.6rem;
        box-shadow: 0 8px 24px rgb(83 83 83 / 0.08);
      }

      .btn {
        display: inline-block;
        background: var(--rojo);
        color: #fff;
        border: none;
        border-radius: 999px;
        padding: 0.7rem 1.8rem;
        font-family: "Jost", sans-serif;
        font-size: 0.95rem;
        font-weight: 500;
        letter-spacing: 0.06em;
        cursor: pointer;
        text-decoration: none;
        transition: transform 0.06s ease, background 0.15s ease;
      }
      .btn:hover {
        background: var(--rojo-oscuro);
      }
      .btn:active {
        transform: scale(0.98);
      }
      .btn.secundario {
        background: var(--verde);
      }
      .btn.secundario:hover {
        background: var(--verde-oscuro);
      }
      .btn.fantasma {
        background: transparent;
        color: var(--titulo);
        border: 1px solid #a49d8d;
        font-weight: 500;
      }
      .btn.fantasma:hover {
        background: rgb(255 255 255 / 0.35);
      }
      .btn:disabled {
        opacity: 0.5;
        cursor: not-allowed;
      }

      label {
        display: block;
        font-weight: 500;
        font-size: 0.85rem;
        letter-spacing: 0.08em;
        text-transform: uppercase;
        color: var(--gris);
        margin: 0.9rem 0 0.3rem;
      }
      input,
      textarea {
        width: 100%;
        padding: 0.6rem 0.8rem;
        border: 1px solid var(--borde);
        border-radius: 12px;
        font: inherit;
        background: #fbf9f2;
        color: var(--texto);
      }
      input:focus,
      textarea:focus {
        outline: 2px solid var(--dorado);
        border-color: transparent;
      }

      .aviso {
        border-radius: 12px;
        padding: 0.7rem 1rem;
        margin: 0.75rem 0;
        font-weight: 500;
        display: none;
      }
      .aviso.error {
        display: block;
        background: #f6e3e3;
        color: var(--rojo-oscuro);
        border: 1px solid #e3bcbc;
      }
      .aviso.ok {
        display: block;
        background: #e4ecdd;
        color: var(--verde-oscuro);
        border: 1px solid #bfd0b4;
      }

      .oculto {
        display: none !important;
      }

      /* ---------- Móvil: cinta superior ---------- */
      @media (max-width: 860px) {
        .sidebar {
          position: sticky; /* fluye con el documento: no tapa el contenido */
          top: 0;
          inset: auto;
          width: 100%;
          border-radius: 0;
          flex-direction: row;
          flex-wrap: nowrap;
          gap: 1rem;
          padding: 0.55rem 0.9rem;
          align-items: center;
        }
        .logo {
          font-size: 0.85rem;
          flex-shrink: 0;
        }
        .logo span {
          display: inline;
          margin-left: 0.3rem;
        }
        .sidebar nav {
          display: none; /* cerrado por defecto; se abre con la hamburguesa */
          position: absolute;
          top: 100%;
          left: 0;
          right: 0;
          flex-direction: column;
          flex-wrap: nowrap;
          gap: 0.4rem;
          background: var(--verde);
          padding: 0.6rem 1rem 1rem;
          box-shadow: 0 12px 20px rgb(0 0 0 / 0.18);
          border-bottom-left-radius: 14px;
          border-bottom-right-radius: 14px;
          overflow: visible;
        }
        .sidebar.abierto nav {
          display: flex;
        }
        .sidebar nav a {
          font-size: 0.8rem;
          white-space: nowrap;
          padding: 0.45rem 0.6rem;
          border-radius: 8px;
        }
        .btn-hamburguesa {
          display: flex;
          margin-left: auto;
        }
        .sidebar .bola-sidebar {
          display: none;
        }
        main {
          margin: 0;
          width: 100%;
          padding: 1.3rem 1.1rem 1.8rem;
        }
        footer {
          margin: 0;
          padding-inline: 1.1rem;
        }
        footer .ramita {
          display: none;
        }
      }
    </style>

    <script>
      // Menú hamburguesa (móvil)
      const sidebar = document.getElementById("sidebar");
      const btnMenu = document.getElementById("btn-menu");

      btnMenu?.addEventListener("click", () => {
        const abierto = sidebar?.classList.toggle("abierto") ?? false;
        btnMenu.setAttribute("aria-expanded", String(abierto));
        btnMenu.setAttribute("aria-label", abierto ? "Cerrar menú" : "Abrir menú");
      });

      // Al navegar a otra página, cerrar el menú
      sidebar?.querySelectorAll("nav a").forEach((a) =>
        a.addEventListener("click", () => {
          sidebar.classList.remove("abierto");
          btnMenu?.setAttribute("aria-expanded", "false");
        })
      );
    </script>
  </body>
</html>
