---
import Layout from "../layouts/Layout.astro";
---

<Layout titulo="Inicio">
  <div class="inicio-centro">
    <div class="btn-contenedor">
      <!-- flechas señalando al botón -->
      <svg class="flecha flecha-izq" viewBox="0 0 24 24" aria-hidden="true">
        <path d="M3 12h17M13 5l7 7-7 7" />
      </svg>
      <a class="btn btn-inicio" href="/ingresar">Iniciar sesión</a>
      <svg class="flecha flecha-der" viewBox="0 0 24 24" aria-hidden="true">
        <path d="M3 12h17M13 5l7 7-7 7" />
      </svg>
      <div class="flecha-abajo-wrap" aria-hidden="true">
        <svg class="flecha flecha-abajo" viewBox="0 0 24 24">
          <path d="M3 12h17M13 5l7 7-7 7" />
        </svg>
      </div>
    </div>
  </div>

  <section class="hero">
    <div class="hero-texto">
      <h1>
        Amigo
        <img src="/img/hoja.png" alt="" class="hoja" />
        <br />Secreto
      </h1>
      <p class="subtitulo">Una Navidad llena de sorpresas</p>
      <p class="descripcion">
        Arma tu lista de deseos, entra al sorteo y descubre a quién le toca
        regalar... sin que nadie sepa nada. Regístrate con el enlace que te
        compartió Ernesto, recibe un código en tu correo y listo. 🤫
      </p>
      <div class="acciones" id="acciones">
        <a class="btn oculto" id="btn-ir" href="/mi-lista">Ir a mi lista</a>
        <a class="btn secundario" href="/participantes">Ver participantes</a>
      </div>
      <p class="nota-invitacion" id="nota-invitacion">
        🎄 Para entrar necesitas el <strong>enlace de invitación</strong> que te
        compartió Ernesto. Ábrelo y regístrate con tu nombre y correo.
      </p>
    </div>

    <div class="hero-arte">
      <img src="/img/hero.png?v=3" alt="Ernesto vestido de Papá Noel en un trineo blanco" />
    </div>
  </section>

  <section class="tarjeta como">
    <h2 style="margin-top:0; text-align:center;">¿Cómo funciona?</h2>
    <ol class="pasos">
      <li><strong>Recibes la invitación:</strong> Ernesto comparte un enlace con el código de invitación.</li>
      <li><strong>Te registras:</strong> pones tu nombre y correo, y recibes un código de 6 dígitos. Sin contraseñas.</li>
      <li><strong>Armas tu lista:</strong> agrega los regalos que te gustaría recibir, con fotos y enlaces.</li>
      <li><strong>El sorteo:</strong> toca el botón y descubre a quién le toca darle un regalo.</li>
      <li><strong>Sorpréndelo:</strong> mira su lista y elige un regalo dentro del presupuesto. 🎄</li>
    </ol>
  </section>
</Layout>

<script>
  import { quienSoy } from "../lib/api.js";

  // Si ya hay sesión, la nota de invitación sobra y mostramos el acceso directo
  const yo = await quienSoy().catch(() => null);
  if (yo) {
    document.getElementById("btn-ir")?.classList.remove("oculto");
    document.getElementById("nota-invitacion")?.classList.add("oculto");
  }
</script>

<style>
  /* Botón principal: centrado arriba, con brillo animado */
  .inicio-centro {
    text-align: center;
    margin-bottom: 0.5rem;
  }
  .btn-contenedor {
    position: relative;
    display: inline-flex;
    align-items: center;
    gap: 1.1rem;
    padding-bottom: 3.4rem; /* espacio para la flecha de abajo */
  }
  .flecha {
    width: 34px;
    height: 34px;
    flex-shrink: 0;
  }
  .flecha path {
    stroke: var(--rojo);
    stroke-width: 2.6;
    fill: none;
    stroke-linecap: round;
    stroke-linejoin: round;
  }
  .flecha-izq {
    animation: acercar-izq 1.1s ease-in-out infinite;
  }
  .flecha-der {
    animation: acercar-der 1.1s ease-in-out infinite;
  }
  .flecha-abajo-wrap {
    position: absolute;
    left: 50%;
    bottom: 0;
    transform: translateX(-50%);
  }
  .flecha-abajo {
    animation: acercar-abajo 1.1s ease-in-out infinite;
  }
  /* 0% = lejos del botón, 50% = cerca (van y vienen) */
  @keyframes acercar-izq {
    0%, 100% { transform: translateX(-12px); opacity: 0.65; }
    50% { transform: translateX(5px); opacity: 1; }
  }
  @keyframes acercar-der {
    0%, 100% { transform: rotate(180deg) translateX(-12px); opacity: 0.65; }
    50% { transform: rotate(180deg) translateX(5px); opacity: 1; }
  }
  @keyframes acercar-abajo {
    0%, 100% { transform: rotate(-90deg) translateX(-12px); opacity: 0.65; }
    50% { transform: rotate(-90deg) translateX(5px); opacity: 1; }
  }
  .btn-inicio {
    display: inline-block;
    font-size: 1.3rem;
    font-weight: 600;
    padding: 1rem 3.2rem;
    animation: brillo 1.8s ease-in-out infinite;
  }
  @keyframes brillo {
    0%, 100% {
      box-shadow:
        0 0 18px 4px rgb(185 67 89 / 0.5),
        0 0 45px 10px rgb(185 67 89 / 0.25);
    }
    50% {
      box-shadow:
        0 0 32px 9px rgb(185 67 89 / 0.85),
        0 0 75px 20px rgb(185 67 89 / 0.4);
    }
  }

  .hero {
    display: grid;
    grid-template-columns: minmax(300px, 1fr) minmax(0, 1.1fr);
    gap: 2rem;
    align-items: center;
    min-height: 62vh;
  }
  .hero-texto {
    padding-left: clamp(0px, 6vw, 110px); /* acerca el texto al centro de la página */
  }
  .hero-texto h1 {
    font-size: clamp(2.6rem, 5.5vw, 4.3rem);
    position: relative;
    display: inline-block;
  }
  .hoja {
    width: 78px;
    margin-left: 0.8rem;
    vertical-align: baseline;
    transform: translateY(-0.4rem) rotate(-8deg);
  }
  .subtitulo {
    margin: 0.4rem 0 0.8rem;
    text-transform: uppercase;
    letter-spacing: 0.3em;
    font-weight: 400;
    font-size: 1.02rem;
    color: var(--titulo);
  }
  .descripcion {
    max-width: 46ch;
    color: var(--gris);
    text-transform: uppercase;
    font-size: 0.88rem;
    letter-spacing: 0.08em;
    line-height: 1.9;
  }
  .acciones {
    display: flex;
    align-items: center;
    gap: 1.4rem;
    margin-top: 1.6rem;
  }
  .nota-invitacion {
    margin: 1.2rem 0 0;
    font-size: 0.95rem;
    color: var(--gris);
    max-width: 44ch;
  }
  .hero-arte {
    position: relative;
    align-self: stretch;
  }
  .hero-arte img:first-child {
    width: 100%;
    height: auto;
    display: block;
    /* desvanece los bordes de la imagen hacia el fondo: sin costuras */
    -webkit-mask-image: linear-gradient(90deg, transparent 0, #000 150px),
      linear-gradient(270deg, transparent 0, #000 150px),
      linear-gradient(180deg, transparent 0, #000 120px),
      linear-gradient(0deg, transparent 0, #000 120px);
    -webkit-mask-composite: source-in;
    mask-image: linear-gradient(90deg, transparent 0, #000 150px),
      linear-gradient(270deg, transparent 0, #000 150px),
      linear-gradient(180deg, transparent 0, #000 120px),
      linear-gradient(0deg, transparent 0, #000 120px);
    mask-composite: intersect;
  }
  .como {
    margin-top: 1.2rem;
  }
  .pasos {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(5, 1fr);
    gap: 1rem;
    counter-reset: paso;
  }
  .pasos li {
    counter-increment: paso;
    position: relative;
    padding-left: 2rem;
    font-size: 0.82rem;
    line-height: 1.5;
  }
  .pasos li::before {
    content: counter(paso);
    position: absolute;
    left: 0;
    top: 0.05rem;
    width: 1.35rem;
    height: 1.35rem;
    border-radius: 50%;
    background: var(--rojo);
    color: #fff;
    font-weight: 600;
    font-size: 0.8rem;
    display: flex;
    align-items: center;
    justify-content: center;
  }
  .pasos strong {
    color: var(--verde-oscuro);
  }

  @media (max-width: 1000px) {
    .hero-texto {
      padding-left: 0;
    }
    .pasos {
      grid-template-columns: 1fr;
      gap: 0.7rem;
    }
    .hero {
      grid-template-columns: 1fr;
      min-height: 0;
    }
    .hero-arte {
      max-width: 520px;
      margin-inline: auto;
    }
    .descripcion {
      text-transform: none;
      letter-spacing: 0;
      font-size: 1rem;
      line-height: 1.7;
    }
  }
</style>
