---
import Layout from "../layouts/Layout.astro";
---

<Layout titulo="Inicio">
  <section class="hero">
    <div class="hero-texto">
      <h1>
        Amigo
        <img src="/img/hoja.png" alt="" class="hoja" />
        <br />Secreto
      </h1>
      <p class="subtitulo">Una Navidad llena de sorpresas</p>
      <p class="descripcion">
        Arma tu lista de deseos, entra al sorteo y descubre a quién le toca
        regalar... sin que nadie sepa nada. Regístrate con el enlace que te
        compartió el organizador, recibe un código en tu correo y listo. 🤫
      </p>
      <div class="acciones" id="acciones">
        <a class="btn oculto" id="btn-ir" href="/mi-lista">Ir a mi lista</a>
        <a class="btn secundario" href="/participantes">Ver participantes</a>
      </div>
      <p class="nota-invitacion" id="nota-invitacion">
        🎄 Para entrar necesitas el <strong>enlace de invitación</strong> que te
        compartió el organizador. Ábrelo y regístrate con tu nombre y correo.
      </p>
    </div>

    <div class="hero-arte">
      <img src="/img/hero.png" alt="Muñeco de nieve sobre un trineo blanco" />
      <img src="/img/bola.png" alt="" class="bola" />
    </div>
  </section>

  <section class="tarjeta como">
    <h2 style="margin-top:0;">¿Cómo funciona?</h2>
    <ol style="margin:0; padding-left:1.25rem; display:grid; gap:0.6rem;">
      <li><strong>Recibes la invitación:</strong> el organizador comparte un enlace con el código de invitación.</li>
      <li><strong>Te registras:</strong> pones tu nombre y correo, y recibes un código de 6 dígitos. Sin contraseñas.</li>
      <li><strong>Armas tu lista:</strong> agrega los regalos que te gustaría recibir, con fotos y enlaces.</li>
      <li><strong>El sorteo:</strong> en la fecha acordada, cada uno descubre a quién le toca darle un regalo.</li>
      <li><strong>Sorpréndelo:</strong> miras su lista, eliges un regalo dentro del presupuesto... y a esperar la fecha. 🎄</li>
    </ol>
  </section>
</Layout>

<script>
  import { quienSoy } from "../lib/api.js";

  // Si ya hay sesión, la nota de invitación sobra y mostramos el acceso directo
  const yo = await quienSoy().catch(() => null);
  if (yo) {
    document.getElementById("btn-ir")?.classList.remove("oculto");
    document.getElementById("nota-invitacion")?.classList.add("oculto");
  }
</script>

<style>
  .hero {
    display: grid;
    grid-template-columns: minmax(300px, 1fr) minmax(0, 1.1fr);
    gap: 2rem;
    align-items: center;
    min-height: 62vh;
  }
  .hero-texto h1 {
    font-size: clamp(2.6rem, 5.5vw, 4.3rem);
    position: relative;
    display: inline-block;
  }
  .hoja {
    width: 78px;
    margin-left: 0.8rem;
    vertical-align: baseline;
    transform: translateY(-0.4rem) rotate(-8deg);
  }
  .subtitulo {
    margin: 0.4rem 0 0.8rem;
    text-transform: uppercase;
    letter-spacing: 0.3em;
    font-weight: 400;
    font-size: 1.02rem;
    color: var(--titulo);
  }
  .descripcion {
    max-width: 46ch;
    color: var(--gris);
    text-transform: uppercase;
    font-size: 0.88rem;
    letter-spacing: 0.08em;
    line-height: 1.9;
  }
  .acciones {
    display: flex;
    align-items: center;
    gap: 1.4rem;
    margin-top: 1.6rem;
  }
  .nota-invitacion {
    margin: 1.2rem 0 0;
    font-size: 0.95rem;
    color: var(--gris);
    max-width: 44ch;
  }
  .hero-arte {
    position: relative;
    align-self: stretch;
  }
  .hero-arte img:first-child {
    width: 100%;
    height: auto;
    display: block;
  }
  .bola {
    position: absolute;
    left: -4.6rem;
    bottom: 1.8rem;
    width: 88px;
    filter: drop-shadow(0 10px 14px rgb(0 0 0 / 0.18));
  }
  .como {
    margin-top: 2.5rem;
  }

  @media (max-width: 1000px) {
    .hero {
      grid-template-columns: 1fr;
      min-height: 0;
    }
    .hero-arte {
      max-width: 520px;
      margin-inline: auto;
    }
    .bola {
      display: none; /* en móvil se sale del ancho y tapa la piña */
    }
    .descripcion {
      text-transform: none;
      letter-spacing: 0;
      font-size: 1rem;
      line-height: 1.7;
    }
  }
</style>
