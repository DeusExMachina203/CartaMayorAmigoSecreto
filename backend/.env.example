# --- Seguridad ---
# Genera uno con: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=cambia-esto
# Contraseña del panel de administración
ADMIN_PASSWORD=cambia-esto

# --- Correo (SMTP de Proton: smtp.protonmail.ch:587 STARTTLS) ---
# Token generado en Ajustes -> Todos los ajustes -> IMAP/SMTP -> Tokens SMTP
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_TOKEN=
# Dirección que aparece como remitente (debe ser la del token)
SMTP_FROM=

# Si SMTP_HOST está vacío, los códigos se imprimen en la consola del servidor
# (útil para desarrollo).

# --- App ---
# Origen del frontend para las cookies y links
FRONTEND_URL=http://localhost:4321
DATABASE_URL=sqlite:///data/app.db
